# ═══════════════════════════════════════════════════════════
# 숲속여행 환경 변수 예시
# 로컬: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 운영: Render 대시보드 → Environment 에 같은 이름으로 등록하세요.
# ═══════════════════════════════════════════════════════════

# ── 인증 (필수) ──────────────────────────────────────────────
# NextAuth 세션 암호화 키. 운영에서는 32자 이상 필수.
# 생성: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 로컬 개발. 운영에서는 https 주소 (예: https://healing-forest.onrender.com)
# Render 에서는 비워 두면 RENDER_EXTERNAL_URL 을 자동으로 사용합니다.
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (선택) ──────────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
# 승인된 리디렉션 URI:
#   http://localhost:3000/api/auth/callback/google
#   https://<운영도메인>/api/auth/callback/google
# 두 값이 비어 있으면 게스트 로그인만 활성화됩니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 게스트 로그인 허용 여부.
# - Google 설정이 없으면 자동으로 허용됩니다.
# - Google 로그인과 게스트를 함께 열려면 true 로 설정하세요.
ALLOW_GUEST_LOGIN=true

# ── 서버 ────────────────────────────────────────────────────
PORT=3000
# 운영에서 NEXTAUTH_URL 과 별도로 허용할 오리진 (쉼표 구분, 선택)
# APP_ORIGIN=https://healing-forest.onrender.com
# ALLOWED_ORIGINS=https://healing-forest.onrender.com

# ── Neon Postgres (선택) ────────────────────────────────────
# 비어 있으면 방문/채팅/장작 상태가 저장되지 않고 인메모리로 동작합니다.
# Neon 콘솔 → Connection string (Pooled connection 권장)
DATABASE_URL=
# Neon 이 제공하는 CA 인증서를 넣으면 TLS 인증서까지 검증합니다. (운영 권장)
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# CA 검증을 끄려면 true (권장하지 않음)
PG_NO_SSL=false
PG_POOL_MAX=5

# ── 기타 ────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
